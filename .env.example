# PostgreSQL connection string from Supabase, Neon, or another managed PostgreSQL provider.
# Configure DATABASE_URL in .env locally and in Vercel Environment Variables.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Used to sign the production session cookie
AUTH_SECRET="replace-with-a-long-random-secret"

# Set true only for local demo data. Keep false in production.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# Cloudinary server-side upload credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Used only when running the non-destructive production-admin seed script
PRODUCTION_ADMIN_USERNAME="admin"
PRODUCTION_ADMIN_EMAIL="admin@example.com"
PRODUCTION_ADMIN_PASSWORD=""
